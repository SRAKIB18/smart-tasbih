<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/widget_item_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Left Icon: 📿 or 🤲 -->
    <TextView
        android:id="@+id/widget_item_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:text="📿"
        android:textSize="22sp" />

    <!-- Title & Bangla Meaning -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Alhamdulillah"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_item_meaning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="আল্লাহর প্রশংসা করা"
            android:textColor="#A7F3D0"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Center Right: Count Badge Pill + Arabic Calligraphy -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_item_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_gold_background"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="33 / 100"
            android:textColor="#F59E0B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_item_arabic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="الْحَمْدُ لِلَّهِ"
            android:textColor="#F59E0B"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Far Right: Emerald Green +1 Button -->
    <Button
        android:id="@+id/widget_item_btn_increment"
        android:layout_width="54dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_btn_green_background"
        android:backgroundTint="#10B981"
        android:padding="0dp"
        android:text="+1"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>